# SFTP/SSH Deployment Configuration
# Copy this file to .env and fill in your actual values
# Never commit .env files with real credentials

# SFTP Server Configuration
SFTP_HOST=your-server.example.com
SFTP_USER=your-username
SFTP_PORT=22
SFTP_REMOTE_PATH=/var/www/html

# SSH Key Authentication
# The SSH private key should be stored in GitHub Secrets as SSH_PRIVATE_KEY
# The public key must be added to the server's ~/.ssh/authorized_keys

# Application Configuration (if needed)
# VITE_SPECIES_PROVIDER=json
# VITE_API_URL=/api/species
