{
	"name": "wcfp-explorer",
	"private": true,
	"version": "0.0.1",
	"description": "World Checklist of Food Plants (WCFP) Explorer - Interactive platform for browsing food plant taxonomy and distribution data",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"preprocess:species": "node scripts/preprocess-species-data.js"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.2",
		"@skeletonlabs/skeleton": "^4.9.0",
		"@skeletonlabs/skeleton-svelte": "^4.9.0",
		"@skeletonlabs/tw-plugin": "^0.4.1",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-static": "^5.0.0",
		"@sveltejs/kit": "^2.49.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"@types/d3-hierarchy": "^3.1.7",
		"@types/d3-interpolate": "^3.0.4",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-scale-chromatic": "^3.1.0",
		"@types/d3-selection": "^3.0.11",
		"@types/d3-shape": "^3.1.8",
		"@types/d3-transition": "^3.0.9",
		"@types/d3-zoom": "^3.0.8",
		"@types/node": "^22.19.5",
		"@vitest/browser-playwright": "^4.0.17",
		"csv-parse": "^6.1.0",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^16.5.0",
		"playwright": "^1.57.0",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.46.1",
		"svelte-check": "^4.3.5",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.53.0",
		"vite": "^7.3.1",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.0.17",
		"vitest-browser-svelte": "^2.0.1",
		"xlsx": "^0.18.5"
	},
	"dependencies": {
		"@deck.gl/core": "^9.2.5",
		"@deck.gl/layers": "^9.2.5",
		"@deck.gl/mapbox": "^9.2.5",
		"@mapbox/mbtiles": "^0.12.1",
		"d3-ease": "^3.0.1",
		"d3-hierarchy": "^3.1.2",
		"d3-interpolate": "^3.0.1",
		"d3-scale": "^4.0.2",
		"d3-scale-chromatic": "^3.1.0",
		"d3-selection": "^3.0.0",
		"d3-shape": "^3.2.0",
		"d3-transition": "^3.0.1",
		"d3-zoom": "^3.0.0",
		"lucide-svelte": "^0.562.0",
		"maplibre-gl": "^5.16.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		],
		"ignoredBuiltDependencies": [
			"sqlite3"
		]
	}
}
